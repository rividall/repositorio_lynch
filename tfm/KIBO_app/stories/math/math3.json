{
  "title": "The Tower of Numbers",
  "pages": [
    {
      "text": "You reach the base of the Tower of Numbers, a place of great trials.",
      "image": "page1.png"
    },
    {
      "text": "To open the tower door, align the number wheel!",
      "image": "page2.png",
      "mini_game": {
        "type": "potentiometer_game"
      }
    },
    {
      "text": "Inside, the halls are lined with ancient math scrolls.",
      "image": "page3.png"
    },
    {
      "text": "A guardian asks you to remember the scroll order.",
      "image": "page4.png",
      "mini_game": {
        "type": "memory_game"
      }
    },
    {
      "text": "Now, pick a symbol of power to carry on.",
      "image": "page5.png",
      "mini_game": {
        "type": "color_choice",
        "options": [
          "Triangle",
          "Circle",
          "Square"
        ],
        "target": "symbol_choice"
      }
    },
    {
      "text": "Solve a logic riddle hidden in the tiles.",
      "image": "page6.png",
      "mini_game": {
        "type": "multiple_choice",
        "options": [
          "Riddle A",
          "Riddle B",
          "Riddle C"
        ],
        "target": "riddle_answer"
      }
    },
    {
      "text": "Draw the final rune to unlock the stairs.",
      "image": "page7.png",
      "mini_game": {
        "type": "drawing_game",
        "target": "final_rune"
      }
    },
    {
      "text": "The top of the tower opens to the sky.",
      "image": "page8.png"
    }
  ]
}