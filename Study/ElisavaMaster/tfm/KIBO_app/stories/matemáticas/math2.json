{
  "title": "The Crystal Caverns",
  "pages": [
    {
      "text": "You enter the Crystal Caverns, where numbers echo through tunnels.",
      "image": "page1.png"
    },
    {
      "text": "You find a glowing puzzle door.",
      "image": "page2.png",
      "mini_game": {
        "type": "potentiometer_game"
      }
    },
    {
      "text": "The door opens to reveal a chamber of floating equations.",
      "image": "page3.png"
